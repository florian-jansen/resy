  "rules": [
    {
      "priority": "2",
      "code": "F",
      "description": "Forest",
      "expression": "<#TC Trees GR 25>",
      "_comment": "Broad type: trees cover more than 25%"
    },
    {
      "priority": "2",
      "code": "W",
      "description": "Wetland and water",
      "expression": "<#TC Wetland GR 25> NOT <#TC Trees GR 25>",
      "_comment": "Broad type: wetland plants cover more than 25%"
    },
    {
      "priority": "2",
      "code": "N",
      "description": "Non-forest",
      "expression": "<#T$ GR 0> NOT (<#TC Trees GR 25> OR <#TC Wetland GR 25>)",
      "_comment": "Broad type: every other plot with vegetation"
    },
    {
      "priority": "5",
      "code": "FB",
      "description": "Beech-fir montane forest",
      "expression": "(<#TC Beech-forest-trees GR 15> AND <#TC Beech-forest-herbs GR 10>)"
    },
    {
      "priority": "4",
      "code": "FF",
      "description": "Beech and fir forest",
      "expression": "<#TC Beech-forest-trees GR 25>"
    },
    {
      "priority": "5",
      "code": "FC",
      "description": "Chestnut forest",
      "expression": "<Castanea sativa GR 25>"
    },
    {
      "priority": "4",
      "code": "FQ",
      "description": "Thermophilous deciduous forest",
      "expression": "<#TC Thermophilous-trees GR 25>"
    },
    {
      "priority": "4",
      "code": "FI",
      "description": "Holm oak forest",
      "expression": "<Quercus ilex GR 10> AND <#TC Trees GR 25>"
    },
    {
      "priority": "4",
      "code": "FR",
      "description": "Riparian forest",
      "expression": "<#TC Riparian-trees GR 25>"
    },
    {
      "priority": "5",
      "code": "NG",
      "description": "Nardus acidic grassland",
      "expression": "(<Nardus stricta GR 10> AND <#TC Nardus-grassland GR 25>) NOT <#TC Trees GR 25>"
    },
    {
      "priority": "3",
      "code": "NS",
      "description": "Sub-Mediterranean scrub and woodland",
      "expression": "<#TC Sub-Mediterranean GR 15> NOT <#TC Trees GR 25>"
    },
    {
      "priority": "5",
      "code": "NA",
      "description": "Ampelodesmos grassland",
      "expression": "<Ampelodesmos mauritanicus GR 15> NOT <#TC Trees GR 25>"
    },
    {
      "priority": "4",
      "code": "NB",
      "description": "Dry grassland",
      "expression": "<#TC Dry-grassland GR 15> NOT <#TC Trees GR 25>"
    },
    {
      "priority": "3",
      "code": "NT",
      "description": "Mediterranean annual grassland",
      "expression": "<#TC Annual-grassland GR 15> NOT <#TC Trees GR 25>"
    },
    {
      "priority": "4",
      "code": "NH",
      "description": "Heath and maquis",
      "expression": "<#TC Heath-maquis GR 25> NOT <#TC Trees GR 25>"
    },
    {
      "priority": "4",
      "code": "ND",
      "description": "Coastal dunes",
      "expression": "<#TC Coastal-dunes GR 15> NOT <#TC Trees GR 25>"
    },
    {
      "priority": "4",
      "code": "WA",
      "description": "Open water",
      "expression": "<#TC Aquatic GR 15> NOT <#TC Trees GR 25>"
    },
    {
      "priority": "4",
      "code": "WM",
      "description": "Marsh and tall herb vegetation",
      "expression": "<#TC Marsh GR 25> NOT <#TC Trees GR 25>"
    },
    {
      "priority": "4",
      "code": "WS",
      "description": "Saltmarsh",
      "expression": "<#TC Saltmarsh GR 15> NOT <#TC Trees GR 25>"
    }
  ]
}
