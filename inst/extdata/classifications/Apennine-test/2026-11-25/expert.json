{
  "metadata": {
    "scheme": "Apennine-test",
    "version": "2026-11-25",
    "description": "Small example expert system for the vegetation of the Italian Apennines and Tuscany: three broad types (forest, non-forest, wetland) and sixteen types."
  },
  "backbone": {
    "name": "EuroSL",
    "url": "https://eurosl.infinitenature.org",
    "version": "2026-11-24"
  },
